# ==============================================================================
# RYVORA DIGITAL - PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Vercel Postgres / Neon / Cloud SQL / Supabase)
# ------------------------------------------------------------------------------
# In Vercel, connecting Neon / Vercel Postgres automatically injects POSTGRES_URL.
# If connecting manually or via another provider, provide POSTGRES_URL or DATABASE_URL.
# When not set, the server gracefully falls back to persistent storage for local dev.
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Secure staff passcode for accessing the Ryvora Admin Console.
# Never expose this variable to the client side (do not prefix with VITE_).
ADMIN_PASSWORD="your_strong_admin_passcode_here"

# Secret key used on the server to cryptographically sign admin session tokens.
ADMIN_SESSION_SECRET="your_random_cryptographic_secret_key_minimum_32_chars"

# ------------------------------------------------------------------------------
# 3. ORDER NOTIFICATION SYSTEM (Optional)
# ------------------------------------------------------------------------------
# Email address where admin alerts for incoming customer orders should be sent.
NOTIFICATION_EMAIL="admin@ryvoradigital.com"

# API key for Resend email dispatch service (https://resend.com)
RESEND_API_KEY="re_123456789abcdef"

# Webhook URL to receive live JSON payloads of customer orders (e.g. Discord, Slack, Zapier)
WEBHOOK_ORDER_URL="https://discord.com/api/webhooks/..."

# ------------------------------------------------------------------------------
# 4. OPTIONAL CLOUD STORAGE
# ------------------------------------------------------------------------------
# Vercel Blob token if using Vercel Blob for payment screenshot uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 5. AI STUDIO / PLATFORM ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000
